rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'uzair9799@gmail.com';
    }

    // Shipments Collection
    match /shipments/{shipmentId} {
      // Anyone can look up a specific shipment if they have the tracking number ID
      allow get: if true;
      
      // Main admin can list all shipments.
      // Other authenticated users can only list shipments NOT created by uzair9799@gmail.com
      allow list: if isMainAdmin() || (
        isSignedIn() && resource.data.createdByEmail.lower() != 'uzair9799@gmail.com'
      );
      
      // Main admin can create any shipment.
      // Other authenticated users can create shipments under their own email (cannot spoof admin email).
      allow create: if isSignedIn() && (
        isMainAdmin() || (
          request.resource.data.createdByEmail.lower() == request.auth.token.email.lower() &&
          request.resource.data.createdByEmail.lower() != 'uzair9799@gmail.com'
        )
      );

      // Main admin can update any shipment.
      // Other authenticated users can only update shipments that were not created by the main admin.
      allow update: if isSignedIn() && (
        isMainAdmin() || (
          resource.data.createdByEmail.lower() != 'uzair9799@gmail.com' &&
          request.resource.data.createdByEmail.lower() != 'uzair9799@gmail.com'
        )
      );

      // Main admin can delete any shipment; users can delete their own created shipments.
      allow delete: if isMainAdmin() || (
        isSignedIn() && resource.data.createdByEmail.lower() == request.auth.token.email.lower()
      );
    }
  }
}

